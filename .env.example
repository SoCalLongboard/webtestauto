# Copy to .env and adjust as needed. All values here are also overridable
# via matching pytest CLI options (--browser, --headless, --grid-url, --site).

# chrome | firefox
BROWSER=chrome

# true | false
HEADLESS=true

# Point at a running Selenium Grid / Remote WebDriver hub instead of a local
# browser, e.g. http://localhost:4444/wd/hub. Leave unset to run locally.
GRID_URL=

# Default site key from config/sites.py used when a test doesn't specify one.
SITE=saucedemo
